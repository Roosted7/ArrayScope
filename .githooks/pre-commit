#!/usr/bin/env bash
#
# Refuse a commit that the CI `Lint (ruff)` job would reject.
#
# This hook exists because that job is not a gate here. It runs on `push` and
# `pull_request`, but the work happens in local worktrees on branches that are
# not pushed, so in practice CI sees main in occasional large batches and
# nothing requires its verdict. Between 2026-07-25 and 2026-07-30, 247 commits
# landed on main without CI running once, and ruff went from clean to 15
# errors inside that window. Commit time is the only moment a lint gate
# reliably fires in this repository.
#
# The checks are exactly the two CI steps, run over the whole tree rather than
# the staged subset: CI lints the tree, and a hook that passed on a partial
# view would be the kind of gate that cannot fail. Both take ~15 ms.
#
# The third check is the dead-code guard, for the same reason ruff is here: it
# is a whole-tree question that only has an answer once the tree is written,
# and it is deliberately NOT a pytest test -- running the same scan under
# pytest costs ~3.7 s on every suite run to re-answer what this hook already
# refused to let past. `tests/app/test_dead_code.py` keeps only the synthetic
# proof that its rules can fail. ~2.1 s here, and it is the one gate that
# catches a deletion's *cascade*, where removing a caller strands the helper
# below it.
#
# The fourth is the timing guard, and it is here for the dead-code reason plus
# one of its own. A fixed pause is added by editing a *test* file, so testmon
# selects that file and never the guard that reads it; under pytest the pause
# would be met on some later full or `--since` run instead of when it was
# written, which is the whole point of having a guard for it.
# `tests/app/test_timing_guard.py` keeps only the synthetic proof that its rules
# can fail -- which is what makes it safe to run the scan nowhere else.
#
# Cost, stated as a ratio because the absolute reading is mostly the box: 0.23-
# 0.26x the dead-code scan above, measured interleaved ABAB across loads of 15
# to 19 on sixteen cores. That was 1.6-2.8 s against its 6-11 s; on a quiet
# machine both shrink together and the quarter holds.
#
# The tools come from this checkout's environment, and the hook finds it
# itself. `git commit` from a plain shell has no venv on PATH, so this gate
# used to refuse the commit and print "commit through tools/env" -- and the
# same commit, retyped, then passed. A step whose only outcome is a retry that
# always succeeds should not be asked for. The hook now performs that recovery
# rather than delegating it.
#
# Missing is still a hard failure, never a skip. What changed is only that the
# hook exhausts the recovery it used to recommend before it reports one.
#
# Bypass with `git commit --no-verify` when you mean to; enable with
#   git config core.hooksPath .githooks
set -euo pipefail

root="$(git rev-parse --show-toplevel)"

# Absolute, because the re-exec below has to name this script from whatever
# cwd it lands in, and git invokes a hook by a path relative to the worktree.
self="${BASH_SOURCE[0]}"
[[ "$self" == /* ]] || self="$PWD/$self"

if [[ -z "${ARRAYSCOPE_HOOK_ENV:-}" ]] &&
	{ ! command -v ruff >/dev/null 2>&1 || ! command -v python >/dev/null 2>&1; } &&
	[[ -x "$root/tools/env" ]]; then
	# Re-run this hook inside the checkout's environment, once.
	#
	# `tools/env` is the same handoff the old message asked for, so this
	# resolves to the identical tools -- and to *this* checkout's, since it
	# walks up from its own location: a worktree keeps its own source on
	# PYTHONPATH while borrowing the parent's venv, which is what the
	# dead-code scan below needs to read the tree being committed.
	#
	# The guard is what makes it once. Without it, an environment that has
	# no ruff would hand the hook back to itself forever; with it, the second
	# pass falls through to the reports below and names what is missing.
	ARRAYSCOPE_HOOK_ENV=1 exec "$root/tools/env" "$self" "$@"
fi

# Not found is a hard failure, never a skip. A hook that waves the commit
# through when its tool is missing reports green for the one situation it
# cannot actually check.
missing_tool() {
	local tool="$1" gate="$2"
	echo "pre-commit: $tool is not on PATH, so the $gate cannot run." >&2
	if [[ -n "${ARRAYSCOPE_HOOK_ENV:-}" ]]; then
		echo "  This checkout's environment does not have it either." >&2
		echo "  Repair it with: uv sync" >&2
	else
		echo "  There is no tools/env here to recover through." >&2
		echo "  Create the environment with: uv sync" >&2
	fi
	echo "  Or bypass deliberately with --no-verify." >&2
	exit 1
}

if ! command -v ruff >/dev/null 2>&1; then
	missing_tool ruff "lint gate"
fi

if ! command -v python >/dev/null 2>&1; then
	missing_tool python "dead-code gate"
fi

status=0

# The two ruff steps run over the Python files this commit actually touches,
# not over the whole working tree.
#
# The header above argues for the whole tree, and that argument is right about
# CI -- but `ruff check .` reads the WORKING TREE, which is not what the commit
# contains. A file some other worktree agent is mid-edit on, or a scratch file
# left dirty beside the change, failed the gate for a commit that did not
# include it. That is not a gate catching a regression, it is a gate refusing
# an unrelated commit, and its only available answer -- reformat someone else's
# in-flight file -- is worse than the problem.
#
# What is given up, stated so nobody rediscovers it as a surprise: a file
# already broken in the tree and NOT touched by this commit no longer fails
# here. It cannot regress from this commit, and CI still lints the tree.
# Partially staged files are checked as they are on DISK, not as staged, so a
# `git add -p` that stages a clean hunk out of a dirty file is checked against
# the dirty version -- stricter than the commit, never looser.
#
# Deletions and renames-away are excluded (ACMR) because ruff cannot lint a
# path that no longer exists. The whole-tree form is kept for the dead-code and
# timing guards below: those are genuinely whole-tree questions -- the
# dead-code guard's entire value is catching a deletion's cascade into files
# this commit does not name.
staged_py=()
while IFS= read -r -d '' path; do
	staged_py+=("$path")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.py' '*.pyi')

if [ ${#staged_py[@]} -gt 0 ]; then
	if ! ruff check -- "${staged_py[@]}"; then
		echo "pre-commit: ruff check failed. Fix with: ruff check --fix ." >&2
		status=1
	fi

	if ! ruff format --check -- "${staged_py[@]}"; then
		echo "pre-commit: ruff format check failed. Fix with: ruff format ." >&2
		status=1
	fi
fi

if ! python "$root/tools/dead_code.py"; then
	echo "pre-commit: dead-code guard failed — code nothing on its own side reaches." >&2
	echo "  Delete it with its assertions, move it to the side that owns it," >&2
	echo "  or give it a real caller. There is no allowlist to add it to." >&2
	status=1
fi

if ! python "$root/tools/timing_guard.py"; then
	echo "pre-commit: timing guard failed — the refusal above names which rule." >&2
	echo "  A pause reads its duration from the throttle bounding it, or waits on" >&2
	echo "  the product's own progress (tests/settle.py). A duration is recorded," >&2
	echo "  never adjudicated. There is no allowlist to add it to — and if you" >&2
	echo "  converted a pause, the backlog number goes down with it." >&2
	status=1
fi

exit "$status"
