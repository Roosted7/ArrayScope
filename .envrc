# Put this checkout's own virtualenv on PATH. One venv per checkout, on
# purpose: an editable install is a pointer, and a single shared environment
# means one pointer decides which checkout *every* process imports -- a branch
# worktree re-pointing it silently redirects the other party's runs. Per-
# checkout venvs cost ~0.2 s and near-zero disk (uv hardlinks from its shared
# cache), so the isolation is free.
#
# Nothing here starts a Python. direnv re-evaluates this file on every
# `direnv exec`, so anything slow in it is paid per command.

if [[ ! -x .venv/bin/python ]]; then
	if command -v uv >/dev/null 2>&1; then
		# A fresh worktree's first `cd` building its environment beats a
		# fresh worktree's first `cd` handing you a broken shell. From uv's
		# warm cache this is a fraction of a second.
		# -q so a `cd` prints one line, not a hundred-package install log.
		# Errors still come through.
		echo "direnv: no .venv yet — running uv sync"
		uv sync -q || echo "direnv: uv sync failed; run \`uv sync\` to see why"
	else
		echo "direnv: no .venv and no uv on PATH. Install uv, then run: uv sync"
	fi
fi

if [[ -x .venv/bin/python ]]; then
	export VIRTUAL_ENV="$PWD/.venv"
	PATH_add .venv/bin
fi
