#!/usr/bin/env bash
#
# Re-check the known load-fragile tests, under load, without running the suite.
#
#     tools/load_fragility                 # the known set, 3 repeats
#     tools/load_fragility -r 5            # 5 repeats
#     tools/load_fragility -t 12           # hold the box at 12 runnable
#                                          # (clamped to nproc-1; see below)
#     tools/load_fragility -t 12 -p        # print the resolved plan and stop
#     tools/load_fragility tests/ui/x.py::test_y   # something specific
#
# The load is CO-OPERATIVE: -t names a total for the machine, not a number of
# loops to add, and the script fills only the gap between that and what is
# already running. Two sessions asking for the same target get that target, not
# twice it, and a session that finds the box already loaded by somebody else
# runs no loops at all.
#
# Two rules keep that from turning into a fight over the machine.
#
# 1. The target is CLAMPED to nproc-1. Past saturation an extra runnable process
#    buys no additional contention, it only takes a core the test itself needs,
#    and a target well above nproc silently imposes that regime on every other
#    session (they see the box already over their own target and run nothing).
#    Asking for more is not an error, it is just rounded down and said so.
# 2. While ANOTHER instance's loops are on the box, this one starts none of its
#    own. Whoever gets there first owns the load; the other defers entirely.
#    Deference is checked every interval, so if the owner exits, the deferring
#    instance ramps up to fill the gap it left.
#
# Two edge cases are knowingly left open, because neither is worth the
# co-ordination it would take to close:
#
# - The owning instance may be holding a LOWER target than we asked for, and we
#   inherit its lighter regime rather than topping it up. Pass -t and read the
#   summary line to see what was actually held.
# - The owning instance may itself have scaled to zero loops (because foreign
#   work already met its target). Then it has no loop processes, we do not see
#   it, and we start loading. That is self-correcting: it sees ours and stays
#   at zero, so exactly one instance owns the loops either way.
#
# Why this exists: the reproduction recipe used to be "three concurrent full
# suites in three worktrees", which is 15 minutes per observation and re-runs
# 4400 tests to learn something about a dozen. The suites are not the point —
# CPU oversubscription is. This puts the box under the same pressure and runs
# only the tests that have ever been observed to care.
#
# The full three-suite run still has one job the cheap version cannot do: find
# *new* members of the set. Run it when the question is "what else is fragile?",
# not when the question is "is this one fixed?".
#
# THE LOAD MUST NEVER OUTLIVE THIS SCRIPT. It is started in its own process
# group and the trap kills that group on every exit path, including Ctrl-C and
# SIGTERM. A background load left behind poisons every measurement anyone takes
# afterwards, including in other checkouts, and it is not obvious from a prompt
# that it is there. If you edit this file, keep the trap first.

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

repeats=3
# Saturation, not the sky, is the ceiling: past nproc-1 runnable an extra spinner
# steals a core from the test under observation without adding contention the
# test can feel. One core is left for the observer itself.
load_cap=$(( $(nproc) - 1 ))
[ "$load_cap" -lt 1 ] && load_cap=1
# The TOTAL runnable count to hold the box at, foreign work included -- not a
# count of our own loops. See ``start_load``.
target=$(( $(nproc) * 3 / 2 ))
max_loaders=0   # 0 means "whatever the target needs"
# Resolve the load plan, announce it, and stop -- before any load is started and
# before pytest is invoked. What the box will be held at is pure arithmetic over
# nproc and the flags, so asking that question should not cost a supervisor
# start-up and a full pytest boot. See the gate below ``start_load``.
plan_only=0

while getopts "r:l:t:ph" opt; do
  case "$opt" in
    r) repeats="$OPTARG" ;;
    t) target="$OPTARG" ;;
    l) max_loaders="$OPTARG" ;;
    p) plan_only=1 ;;
    h) sed -n '2,53p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) exit 2 ;;
  esac
done
# Clamp rather than reject: the default is itself above the cap on every machine
# with more than two cores, so refusing would make the no-argument form an error.
# Say so when it bites, or the summary line reads as a target nobody asked for.
if [ "$target" -gt "$load_cap" ]; then
  printf 'load: target %s exceeds nproc-1; holding %s instead\n' "$target" "$load_cap"
  target="$load_cap"
fi
[ "$max_loaders" -gt 0 ] 2>/dev/null || max_loaders="$target"
[ "$max_loaders" -gt "$load_cap" ] && max_loaders="$load_cap"
shift $((OPTIND - 1))

# Loop processes carry this plus our PID, so "another instance's loops" and "our
# loops" are answerable from the process table alone -- no lockfile to go stale
# when a session is killed. The "-loop-" half is assembled inside the supervisor
# so that neither this script's nor the supervisor's own command line matches the
# pattern used to find loops; only real loops do.
load_marker="arrayscope-load-fragility"
load_tag="$$"

# Every test observed to fail under the 2026-08-01 three-suite experiment, plus
# the ones the fixes to those touched. Add a row when a new one is found; do not
# remove a row because it now passes — that is what this script is for.
default_targets=(
  # Still red under load, and each is understood; see docs/queue.md.
  "tests/ui/test_montage_out_of_view_retention.py::test_wgpu_pan_away_and_back_reuses_the_retained_presentation_scope"
  "tests/ui/test_panel_layout.py::test_restored_layout_uses_saved_viewport_session"
  "tests/ui/test_file_view_session.py::test_settings_viewport_session_uses_viewport_continuity_transaction"
  "tests/ui/test_montage_settled_quiescence.py::test_settled_montage_after_a_data_change_owes_no_bookkeeping[wgpu]"
  # Fixed 2026-08-01; kept so a regression is caught here rather than in a suite.
  "tests/ui/test_window_sync.py::test_camera_pan_zoom_syncs_between_windows"
  "tests/ui/test_pyqtgraph_preview_transition.py::test_single_slice_to_full_montage_presents_around_retained_exact_tile[scalar]"
  "tests/app/test_memory_stress.py::test_montage_tile_residency_reuses_its_working_set_on_a_second_walk"
  "tests/ui/test_resident_crop_rebind.py::test_single_slice_rebind_hover_reads_the_new_window_value"
  "tests/ui/test_resident_crop_rebind.py::test_resident_crop_scrub_schedules_no_producers"
  "tests/ui/test_resident_crop_rebind.py::test_crop_scrub_without_the_capability_still_evaluates"
  "tests/ui/test_performance_settings.py::test_host_cache_compression_menu_switches_and_persists"
  "tests/ui/test_montage_interactions.py::test_wgpu_expanded_montage_never_hides_retained_sixty"
  "tests/ui/test_montage_interactions.py::test_montage_tile_count_increase_preserves_manual_zoom_when_not_near_auto[pyqtgraph]"
  "tests/app/test_open_flow.py::test_streaming_rec_updates_viewer_before_completion"
  # Was a wall-clock comparison (`empty_ms <= working_ms`) between two small
  # measurements: passed serially, inverted under parallel load. Restated on
  # the commit counters 2026-08-01 and renamed; kept here because the row is
  # the regression handle, not a to-do. The stopwatch it replaced could not
  # fail for the reason it named on this backend at all.
  "tests/render/test_commit_cost_scaling.py::test_an_empty_delta_stays_on_the_incremental_path[pyqtgraph]"
  # Seen once each in the 2026-08-01 verification runs, cause not yet pinned.
  "tests/ui/test_lod_demand_freshness.py::test_zoom_in_rederives_lod_demand"
  "tests/ui/test_viewport_convergence_latch.py"
  # Both share `_halo_montage_window`, which retargeted a session that was
  # still converging; the render's own viewport retarget then landed on top of
  # the small window and the halo stopped being a subset, failing the fixture's
  # regime assertion in whichever of the two called it. Fixed 2026-08-01.
  "tests/ui/test_prefetch.py::test_idle_prefetch_walks_the_retention_halo_before_the_rest_of_the_montage"
  "tests/ui/test_prefetch.py::test_a_window_resize_leaves_the_priority_halo_intact"
)

targets=("$@")
if [ ${#targets[@]} -eq 0 ]; then
  targets=("${default_targets[@]}")
fi

load_pgid=""

cleanup() {
  local status=$?
  if [ -n "$load_pgid" ]; then
    kill -- "-$load_pgid" 2>/dev/null || true
    sleep 0.2
    kill -9 -- "-$load_pgid" 2>/dev/null || true
  fi
  # Belt and braces for a straggler whose process group died under it. Scoped to
  # OUR tag, never the bare marker: now that a second instance legitimately runs
  # its own loops beside ours, killing every loop on the box on our way out would
  # cut the other session's load out from under it mid-measurement, and it would
  # then ramp straight back up -- the exact oscillation the co-operative
  # supervisor exists to prevent.
  # Anchored for the same reason the supervisor anchors: unanchored, this would
  # also match any process whose command line merely quotes our tag.
  pkill -9 -f "${load_marker}-loop-${load_tag}\$" 2>/dev/null || true
  return $status
}
trap cleanup EXIT INT TERM HUP

# The supervisor holds the BOX at ``target`` runnable processes, rather than
# adding a fixed number of loops to whatever is already there.
#
# This machine normally has several agent sessions on it, and more than one of
# them may want the box loaded. A fixed loop count makes those requests add up:
# two scripts asking for 24 get 48, which is not the regime either of them
# meant to test and is how a 62 GB box got OOM-killed. Reading the load and
# filling only the gap makes the requests *compose* — if somebody else is
# already loading the machine, this backs off, and can legitimately run zero
# loops. Their load is as good as ours; only the total matters.
#
# ``procs_running`` from /proc/stat, not the 1-minute load average: the average
# lags by a minute, so a script reacting to it would spend the first minute
# over-loading and the last minute idle. procs_running is the instantaneous
# runnable count, which is exactly the quantity being held.
start_load() {
  setsid bash -c '
    target=$1
    max=$2
    marker=$3
    tag=$4
    # Assembled here rather than passed in whole, so this supervisor own command
    # line does not match the pattern that finds loops.
    #
    # ANCHORED, and that anchor is load-bearing. A loop carries its tag as the
    # last argv element, so requiring the match to end the command line is what
    # separates a real loop from any process that merely mentions the marker --
    # an agent harness echoing the command, a `pgrep -af arrayscope-...` someone
    # typed, this script quoted in a log tail. Unanchored, every one of those
    # reads as "another instance is loading" and this one defers forever, which
    # is a silent zero-load run rather than the regime that was asked for.
    ours_pattern="${marker}-loop-${tag}\$"
    any_pattern="${marker}-loop-[0-9]+\$"
    pids=()
    stop_all() { [ ${#pids[@]} -gt 0 ] && kill -9 "${pids[@]}" 2>/dev/null; exit 0; }
    trap stop_all TERM INT HUP
    while :; do
      # Drop the ones that have gone, so "ours" is a live count.
      alive=()
      for p in ${pids[@]+"${pids[@]}"}; do
        kill -0 "$p" 2>/dev/null && alive+=("$p")
      done
      pids=(${alive[@]+"${alive[@]}"})

      # Three samples: procs_running is instantaneous and jitters by a couple
      # of processes as workers block on IO and wake again.
      total=0
      for _ in 1 2 3; do
        total=$(( total + $(awk "/^procs_running/{print \$2}" /proc/stat) ))
        sleep 0.1
      done
      running=$(( total / 3 ))

      ours=${#pids[@]}
      foreign=$(( running - ours ))
      [ "$foreign" -lt 0 ] && foreign=0
      want=$(( target - foreign ))
      [ "$want" -lt 0 ] && want=0
      [ "$want" -gt "$max" ] && want="$max"

      # Defer to an instance that is already loading. Two supervisors each
      # filling "the gap" both count the other loops as foreign, so they do
      # converge on the total -- but they converge by fighting, each trimming
      # against the other on every interval. One owner is steadier and the
      # regime is identical. Re-checked every interval rather than once at
      # startup: when the owner exits, its loops leave the process table and
      # this becomes an ordinary gap fill on the next pass.
      #
      # Only ever a reason not to START. Once we own loops we keep managing
      # them, otherwise two instances that came up together would both see the
      # other and both back down to zero.
      loops_now=$(pgrep -fc "$any_pattern" 2>/dev/null || true)
      [ -z "$loops_now" ] && loops_now=0
      foreign_loops=$(( loops_now - ours ))
      [ "$foreign_loops" -lt 0 ] && foreign_loops=0
      if [ "$ours" -eq 0 ] && [ "$foreign_loops" -gt 0 ]; then
        want=0
      fi

      while [ "${#pids[@]}" -lt "$want" ]; do
        bash -c "while :; do :; done" "$ours_pattern" &
        pids+=("$!")
      done
      while [ "${#pids[@]}" -gt "$want" ]; do
        kill -9 "${pids[-1]}" 2>/dev/null || true
        unset "pids[-1]"
        pids=(${pids[@]+"${pids[@]}"})
      done
      sleep 1
    done
  ' _ "$target" "$max_loaders" "$load_marker" "$load_tag" &
  load_pgid=$!
  # setsid makes the child its own group leader, so its pid is its pgid, and the
  # cleanup trap above kills the supervisor and every loop it owns in one go.
  sleep 2
}

printf 'load: holding %s runnable on %s cores (foreign load counts; max %s of our own); %s repeat(s) over %s target(s)\n' \
  "$target" "$(nproc)" "$max_loaders" "$repeats" "${#targets[@]}"

# Deliberately HERE, between the announcement and the first thing that costs:
# every number -p reports is one the real path just computed and printed on the
# lines above, so the cheap answer cannot drift from the expensive one. Moving
# this gate above either printf, or below start_load, is what the plan test
# checks for.
if [ "$plan_only" -eq 1 ]; then
  printf 'load: plan only (-p): no load started, no tests run\n'
  exit 0
fi

start_load
trap 'echo; echo "interrupted — stopping load"; exit 130' INT

declare -a results
status=0
for ((run = 1; run <= repeats; run++)); do
  printf '\n--- run %s/%s (load average %s)\n' "$run" "$repeats" "$(cut -d' ' -f1 /proc/loadavg)"
  # A SKIP is not a survival. `require_wgpu_adapter` gating a target on a box
  # without Vulkan is legitimate, but a target that skipped for any reason did
  # not face the load this script exists to apply -- and pytest exits 0 either
  # way, so reading the exit status alone verdicts it PASS. That is the blind
  # spot of the tool built to re-check fragile tests under load, and a false
  # skip is exactly what queue row "the silent wgpu skip" describes: a call
  # -phase skip carrying a reason that is not true.
  out="$("$root/tools/env" pytest "${targets[@]}" -q --testmon-noselect 2>&1)"
  rc=$?
  printf '%s\n' "$out" | tail -25
  skipped="$(printf '%s' "$out" | grep -oE '[0-9]+ skipped' | tail -1 | cut -d' ' -f1)"
  if [ "$rc" -ne 0 ]; then
    results+=("run $run: FAIL")
    status=1
  elif [ -n "$skipped" ] && [ "$skipped" -gt 0 ]; then
    results+=("run $run: PASS but $skipped SKIPPED — a skipped target did not face the load")
    status=1
  else
    results+=("run $run: PASS")
  fi
done

printf '\n=== load-fragility summary (held %s runnable)\n' "$target"
printf '%s\n' "${results[@]}"
exit $status
