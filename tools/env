#!/usr/bin/env bash
#
# Run one command in this checkout's environment without paying for activation.
#
#     tools/env pytest                  # the loop
#     tools/env pytest --since          # before merging
#     tools/env ruff check .
#     tools/env git commit ...          # puts ruff+python on PATH for the hook
#
# Why this exists: `direnv exec . <command>` re-evaluates .envrc on every single
# call. Under the retired conda .envrc that meant a `conda shell.bash hook` plus
# a `conda env list` per command — measured 1.56 s on the reference machine
# before the command even started, 3x the suite's entire no-op fast path. An
# interactive shell pays that once per `cd` and never notices; a script or an
# agent pays it per command. The uv .envrc is far cheaper, but the principle
# stands: a venv does not need activating to be *used*. Its binaries run fine by
# path, so this just finds the venv and execs. ~5 ms.
#
# The venv is per-checkout (<repo root>/.venv, created by `uv sync`) and found
# by walking up from this script's own location, never from the caller's cwd:
# harnesses reset cwd between commands, and the whole point of one venv per
# checkout is that `tools/env` in *this* tree uses *this* tree's install.
#
# An unusual layout states its location once:
#
#     export ARRAYSCOPE_ENV_PREFIX=/wherever/.venv

set -euo pipefail

prefix="${ARRAYSCOPE_ENV_PREFIX:-}"

if [[ -z "$prefix" ]]; then
	# Walk up from this script, not from $PWD.
	dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
	while :; do
		if [[ -x "$dir/.venv/bin/python" ]]; then
			prefix="$dir/.venv"
			break
		fi
		[[ "$dir" == "/" ]] && break
		dir="$(dirname "$dir")"
	done
fi

if [[ -z "$prefix" && -n "${VIRTUAL_ENV:-}" && -x "${VIRTUAL_ENV}/bin/python" ]]; then
	# Already activated and no checkout venv to prefer: trust the shell rather
	# than second-guessing it.
	prefix="$VIRTUAL_ENV"
fi

if [[ -z "$prefix" || ! -x "$prefix/bin/python" ]]; then
	echo "tools/env: no ArrayScope environment found." >&2
	echo "  Create it:   uv sync" >&2
	echo "  Or name it:  export ARRAYSCOPE_ENV_PREFIX=/path/to/.venv" >&2
	exit 1
fi

export VIRTUAL_ENV="$prefix"
export PATH="$prefix/bin:$PATH"

exec "$@"
